<%- include('partials/header', { pageTitle: 'User Profile - UNIMQ', bodyClass: 'bg-cream-bg text-dark-text min-h-screen font-sans selection:bg-accent-green selection:text-white pb-20' }) %>
<nav class="flex justify-between items-center px-6 py-6 max-w-7xl mx-auto">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-accent-green">UNIMQ</h1>
    <p class="text-sm text-muted-text font-medium">Profile Settings</p>
  </div>
  <div class="flex items-center gap-4">
    <a href="/dashboard" class="text-gray-600 font-semibold hover:text-black transition-colors text-sm px-4 py-2 bg-gray-100 rounded-lg">Kembali</a>
  </div>
</nav>

<main class="max-w-2xl mx-auto px-6 mt-8">
  <div class="mb-8">
    <h2 class="text-4xl font-bold mt-1">My Profile</h2>
    <p class="text-muted-text mt-2 font-medium">Kelola informasi akun dan kata sandi Anda.</p>
  </div>

  <div class="bg-card-white rounded-3xl p-8 shadow-xl shadow-gray-200/50 border border-transparent">
    <div class="flex items-center gap-6 mb-10 pb-8 border-b border-gray-100">
      <div class="w-20 h-20 bg-accent-green/10 rounded-full flex items-center justify-center text-accent-green">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-dark-text"><%= user.username %></h3>
        <p class="text-sm text-muted-text font-medium uppercase tracking-wider mt-1">User ID: <%= user.user_id %></p>
      </div>
    </div>

    <form method="post" action="/profile" class="space-y-6">
      <div class="mb-6">
        <h4 class="text-lg font-bold text-dark-text flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-brown" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Ubah Password
        </h4>
      </div>
      <div>
        <label class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-600 block mb-2 px-1">Password Saat Ini</label>
        <input type="password" name="current_password" placeholder="••••••••" required class="w-full px-5 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:border-accent-green focus:ring-1 focus:ring-accent-green outline-none transition duration-200">
      </div>
      <div>
        <label class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-600 block mb-2 px-1">Password Baru</label>
        <input type="password" name="new_password" placeholder="Minimal 8 karakter" required minlength="8" class="w-full px-5 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:border-accent-green focus:ring-1 focus:ring-accent-green outline-none transition duration-200">
      </div>
      <div>
        <label class="text-[0.65rem] font-bold uppercase tracking-wider text-gray-600 block mb-2 px-1">Konfirmasi Password Baru</label>
        <input type="password" name="confirm_password" placeholder="Ketik ulang password baru" required minlength="8" class="w-full px-5 py-3 rounded-xl bg-gray-50 border border-gray-200 focus:border-accent-green focus:ring-1 focus:ring-accent-green outline-none transition duration-200">
      </div>
      <div class="pt-4 border-t border-gray-100">
        <button type="submit" class="w-full bg-accent-green text-white font-bold py-4 rounded-xl shadow-sm shadow-green-900/10 hover:bg-[#2e5910] hover:-translate-y-0.5 transition-all duration-300">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
